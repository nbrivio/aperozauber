---
// Fester Kopf. Das Siegel steht fest links und bewegt sich nicht. Auf der Startseite
// ist der Kopf am Anfang durchsichtig und blendet beim Scrollen ein.
import Siegel from './Siegel.astro';
import Hinweisband from './Hinweisband.astro';
import { betrieb } from '../inhalt/betrieb.js';
import { pfad } from '../inhalt/pfad.js';

const start = pfad('/');
const [vorname, marke] = betrieb.name.split(' ');
const punkte = [
  ['angebot/', 'Kreationen'],
  ['firmenapero/', 'Für Firmen'],
  ['uebermich/', 'Sibylle'],
  ['info/', 'Gut zu wissen'],
];
const hier = Astro.url.pathname;

// Liegt das offizielle Instagram-Zeichen als Datei im Projekt, wird es gezeigt. Sonst steht ein eigenes @-Zeichen.
const zeichen = Object.values(import.meta.glob('../assets/marke/instagram.svg', { eager: true, query: '?url', import: 'default' }))[0];
---

<header class="kopf" data-kopf>
  <Hinweisband />
  <div class="kopf__leiste">
    <a class="marke" href={start}>
      <Siegel class="marke__siegel" breiten={[54, 108, 162]} sizes="54px" alt="" eilig />
      <span class="marke__wort"><b>{vorname}</b> <i>{marke}</i><span class="verborgen">, Startseite</span></span>
    </a>
    <nav aria-label="Hauptnavigation">
      {punkte.map(([ziel, name]) => <a href={`${start}${ziel}`} aria-current={hier.startsWith(`${start}${ziel}`) ? 'page' : undefined}>{name}</a>)}
      <a class="netz" href={betrieb.instagram} rel="noopener noreferrer" aria-label="Apérozauber auf Instagram">
        {zeichen ? <img src={zeichen} alt="" width="22" height="22" /> : <span aria-hidden="true">@</span>}
      </a>
    </nav>
    <a class="knopf" href={`${start}#anfrage`}>Apéro anfragen</a>
  </div>
</header>

<style>
  .kopf {
    --t: 1;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 30;
  }
  /* Mit der Tastatur im Kopf ist er immer sichtbar. */
  .kopf:focus-within {
    --t: 1 !important;
  }
  .kopf__leiste {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    height: var(--kopf-h);
    padding: 0 max(16px, var(--rand) - 6px) 0 var(--rand);
    background-color: rgb(246 243 236 / var(--t));
    border-bottom: 1px solid rgb(39 36 31 / calc(var(--t) * 0.18));
  }
  .marke {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    line-height: 1;
    opacity: var(--t);
    margin-left: -6px;
  }
  .marke :global(.marke__siegel) {
    width: 54px;
    height: 54px;
  }
  .marke b {
    display: block;
    font: 500 11px/1 var(--az-font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .marke i {
    display: block;
    font: 400 22px/1 var(--az-font-display);
    font-style: normal;
    margin-top: 2px;
  }
  nav {
    display: none;
    gap: 26px;
    font: 500 13px/1 var(--az-font-body);
    letter-spacing: 0.06em;
    opacity: var(--t);
  }
  nav a {
    text-decoration: none;
    padding: 8px 0;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s;
  }
  nav {
    align-items: center;
  }
  nav .netz {
    align-self: center;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--az-ink);
    border-radius: 50%;
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  nav .netz span {
    font: 500 15px/1 var(--az-font-body);
    letter-spacing: 0;
    transform: translateY(-1px);
  }
  @media (hover: hover) {
    nav .netz:hover {
      background: var(--az-ink);
      color: var(--az-paper);
    }
    nav .netz:hover img {
      filter: invert(1);
    }
  }
  nav a[aria-current] {
    border-color: currentColor;
  }
  @media (hover: hover) {
    nav a:hover {
      border-color: currentColor;
    }
  }
  .knopf {
    padding: 12px 13px;
    font-size: 12px;
    white-space: nowrap;
  }
  @media (min-width: 900px) {
    .kopf__leiste {
      padding-inline: var(--rand);
    }
    nav {
      display: flex;
    }
  }
  /* Auf sehr schmalen Bildschirmen bleibt das Siegel, der Name bleibt für Vorleseprogramme. */
  @media (max-width: 359px) {
    .marke__wort {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
