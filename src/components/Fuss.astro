---
import Siegel from './Siegel.astro';
import { getCollection } from 'astro:content';
import { betrieb } from '../inhalt/betrieb.js';
import { pfad } from '../inhalt/pfad.js';

const start = pfad('/');
const recht = (await getCollection('recht')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
---

<footer class="dunkel">
  <div class="innen">
    <Siegel farbe="weiss" breiten={[150, 300]} class="fuss__siegel" />
    <div class="fuss__angaben">
      <span class="hand" lang="it">More apéro, per favore.</span>
      <span>{betrieb.name}, {betrieb.plz} {betrieb.ort}</span>
      <span>
        <a href={`mailto:${betrieb.email}`}>{betrieb.email}</a> · <a href={`tel:${betrieb.telefon.replaceAll(' ', '')}`}>{betrieb.telefon.replaceAll(' ', '\u00a0')}</a>
      </span>
      <a href={betrieb.instagram} rel="noopener noreferrer">Instagram @aperozauber</a>
    </div>
    <nav aria-label="Seiten und Rechtliches">
      <a href={`${start}angebot/`}>Kreationen</a>
      <a href={`${start}firmenapero/`}>Firmenapéro</a>
      <a href={`${start}uebermich/`}>Über mich</a>
      <a href={`${start}info/`}>Gut zu wissen</a>
      {recht.map((r) => <a href={`${start}impressum/#${r.id}`}>{r.data.kurz ?? r.data.titel}</a>)}
    </nav>
  </div>
</footer>

<style>
  footer {
    padding: clamp(40px, 6vw, 80px) var(--rand) 120px;
    font-size: 14px;
    border-top: 1px solid rgb(246 243 236 / 0.2);
  }
  .innen {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    justify-content: space-between;
  }
  footer :global(.fuss__siegel) {
    width: 150px;
    height: 150px;
  }
  .fuss__angaben {
    display: grid;
    gap: 2px;
    align-content: center;
    justify-items: start;
  }
  .hand {
    font-size: clamp(34px, 4vw, 52px);
    color: var(--az-linen);
    margin-bottom: 6px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
    align-content: start;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
  }
  nav a {
    min-height: 44px;
  }
  @media (min-width: 900px) {
    .innen {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
      align-items: center;
    }
    .innen > :global(picture) {
      display: block;
      grid-column: 1 / 4;
    }
    .fuss__angaben {
      grid-column: 4 / 9;
    }
    nav {
      grid-column: 9 / -1;
      justify-content: flex-end;
    }
  }
</style>
