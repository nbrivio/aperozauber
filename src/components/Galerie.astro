---
// Sechs Bilder als Fläche: das erste gross, die anderen daneben und darunter.
import { Picture } from 'astro:assets';

const { bilder } = Astro.props;
---

<div class="galerie">
  {bilder.map((b) => <Picture src={b.bild} alt={b.bildAlt} formats={['avif', 'webp']} widths={[360, 640, 900]} sizes="(max-width: 800px) 46vw, (max-width: 1400px) 30vw, 440px" loading="lazy" />)}
</div>

<style>
  .galerie {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding: 0 var(--rand);
    max-width: calc(var(--az-content-width) + 2 * var(--rand));
    margin: 0 auto;
  }
  /* Das Bild-Element selbst ist die Kachel. */
  .galerie :global(picture) {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }
  .galerie :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 800px) {
    .galerie {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
    .galerie :global(picture:first-child) {
      grid-column: span 2;
      grid-row: span 2;
      aspect-ratio: auto;
    }
  }
</style>
