---
// Das Originalsiegel, unverändert. Ausgeliefert wird eine gerechnete Fassung in passender Grösse,
// die Vorlage bleibt die Vektordatei daneben (siehe werkzeuge/markenbilder.mjs).
import { getImage } from 'astro:assets';
import schwarz from '../assets/marke/siegel.webp';
import weiss from '../assets/marke/siegel-weiss.webp';
import { betrieb } from '../inhalt/betrieb.js';

const { farbe = 'schwarz', breiten = [160, 320], sizes, eilig = false, wichtig = false, alt = betrieb.name, class: klasse } = Astro.props;
const quelle = farbe === 'weiss' ? weiss : schwarz;

const satz = async (format, quality) => {
  const stufen = await Promise.all(breiten.map((breite) => getImage({ src: quelle, width: breite, height: breite, format, quality })));
  return { erste: stufen[0].src, srcset: stufen.map((bild, i) => `${bild.src} ${breiten[i]}w`).join(', ') };
};
const avif = await satz('avif', 50);
const webp = await satz('webp', 90);
const groessen = sizes ?? `${breiten[0]}px`;
---

<picture class="siegel">
  <source type="image/avif" srcset={avif.srcset} sizes={groessen} />
  <img
    class={klasse}
    src={webp.erste}
    srcset={webp.srcset}
    sizes={groessen}
    width={breiten[0]}
    height={breiten[0]}
    alt={alt}
    loading={eilig ? 'eager' : 'lazy'}
    fetchpriority={wichtig ? 'high' : undefined}
    decoding="async"
  />
</picture>
