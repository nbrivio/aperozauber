---
// Die Anfrage. Ohne Skript steht das Formular hier im Kapitel und öffnet das Mailprogramm.
// Mit Skript zieht es ins Bestellfenster um, das die Blase und jeder Knopf «anfragen» öffnet.
// Ist ein Empfänger gesetzt (SITE_ANFRAGE_ZIEL), geht die Anfrage direkt dorthin.
import { getCollection, getEntry, render } from 'astro:content';
import { Picture } from 'astro:assets';
import { titelAlsHtml } from '../../inhalt/titel.js';
import { mengenwort, preiszeile, preisJeGroesse } from '../../inhalt/preis.js';
import { betrieb } from '../../inhalt/betrieb.js';

const text = await getEntry('texte', 'anfrage');
const { Content } = await render(text);
const t = text.data;
const m = t.meldungen;
const kreationen = (await getCollection('kreationen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const groessen = (await getEntry('texte', 'angebot')).data.etikett;
const ziel = process.env.SITE_ANFRAGE_ZIEL ?? '';
const telefon = betrieb.telefon.replaceAll(' ', ' ');
---

<section class="anfrage dunkel" id="anfrage" aria-labelledby="anfrage-titel">
  <div class="innen">
    <p class="etikett">{t.etikett}</p>
    <h2 id="anfrage-titel" set:html={titelAlsHtml(t.titel)} />

    <div class="ruf" data-ruf hidden>
      <div class="gross"><Content /></div>
      <a class="knopf hell" href="#anfrage">{m.oeffnen}</a>
      <p class="hinweis">
        {m.oder} <a href={`mailto:${betrieb.email}`}>{betrieb.email}</a> · <a href={`tel:${betrieb.telefon.replaceAll(' ', '')}`}>{telefon}</a>
      </p>
    </div>

    <div data-formularplatz>
      <form
        data-anfrage
        data-ziel={ziel || undefined}
        data-meldungen={JSON.stringify(m)}
        action={`mailto:${betrieb.email}`}
        method="post"
        enctype="text/plain"
        novalidate
      >
        <fieldset>
          <legend>{m.auswahl}</legend>
          <p class="hinweis">{groessen}</p>
          <div class="liste">
            {
              kreationen.map(({ id, data: k }) => (
                <div class:list={['posten', `posten--${k.art}`]} role="group" aria-label={k.name} data-posten={id}>
                  <div class:list={['rund', k.bild ? null : `ton-${k.ton}`]}>
                    {k.bild && <Picture src={k.bild} alt="" formats={['avif', 'webp']} widths={[60, 120, 180]} sizes="60px" loading="lazy" />}
                  </div>
                  <div class="name">
                    <b>{k.name}</b>
                    <span>{k.art === 'kreation' ? preisJeGroesse(k) : [k.notiz, preiszeile(k)].filter(Boolean).join(' · ')}</span>
                  </div>
                  <div class="mengen">
                    {(k.art === 'kreation' ? k.groessen.map((g) => g.groesse) : ['']).map((g) => {
                      const wort = g || mengenwort(k);
                      const was = g ? `${k.name} ${g}` : k.name;
                      return (
                        <div class="menge">
                          <span aria-hidden="true">{wort}</span>
                          <div class="menge__feld">
                            <button type="button" data-schritt="-1" aria-label={`${was}: eins weniger`}>−</button>
                            <input type="number" name={g ? `${id}-${g}` : id} min="0" max={g ? 20 : 40} value="0" inputmode="numeric" aria-label={`${was}, Anzahl`} data-p={k.name} data-g={g} />
                            <button type="button" data-schritt="1" aria-label={`${was}: eins mehr`}>+</button>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend>Für wen?</legend>
          <div class="wahl">
            <label><input type="radio" name="fuer" value="Privat" checked /><span>Privat</span></label>
            <label><input type="radio" name="fuer" value="Firma" /><span>Firma</span></label>
          </div>
        </fieldset>

        <div class="paarweise">
          <div class="feld"><label for="wieviele">Wie viele?</label><input type="number" id="wieviele" name="wieviele" min="1" max="500" inputmode="numeric" placeholder="Gäste, ungefähr" /></div>
          <div class="feld"><label for="wann">Wann?</label><input type="date" id="wann" name="wann" /></div>
        </div>
        <div class="feld"><label for="wo">Wo?</label><input type="text" id="wo" name="wo" placeholder="Abholung in Villmergen oder Lieferort" /></div>
        <div class="feld"><label for="wuensche">Noch etwas?</label><textarea id="wuensche" name="wuensche" rows="2" placeholder="Wünsche, Allergien, Anlass"></textarea></div>
        <div class="paarweise">
          <div class="feld"><label for="name">Wer?</label><input type="text" id="name" name="name" autocomplete="name" placeholder="Dein Name" /></div>
          <div class="feld"><label for="kontakt">Antwort an?</label><input type="text" id="kontakt" name="kontakt" autocomplete="email" placeholder="E-Mail oder Telefon" /></div>
        </div>
        <p class="falle" aria-hidden="true"><label>Bitte leer lassen <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></p>

        <div class="ankunft" data-ankunft hidden>
          <p class="etikett">{t.satz}</p>
          <p class="vorschau" data-vorschau></p>
        </div>
        <div class="wege">
          <button class="knopf hell" type="submit">{t.knopf}</button>
        </div>
        <p class="meldung" data-meldung role="status"></p>
        <div class="hinweis"><Content /></div>
      </form>
    </div>
  </div>
</section>

<dialog class="fenster-anfrage dunkel" data-fenster aria-labelledby="fenster-titel">
  <div class="fenster-anfrage__kopf">
    <h2 id="fenster-titel">{m.fenster}</h2>
    <button class="fenster-anfrage__zu" type="button" data-zu aria-label="Fenster schliessen">×</button>
  </div>
  <div class="fenster-anfrage__inhalt" data-fensterplatz></div>
  <template data-dank>
    <div class="dank">
      <p class="hand">{m.dank}</p>
      <p class="gross" data-danktext></p>
      <button class="knopf hell" type="button" data-zu>Schliessen</button>
    </div>
  </template>
</dialog>
