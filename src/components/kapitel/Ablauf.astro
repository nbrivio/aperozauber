---
import { getEntry } from 'astro:content';
import { pfad } from '../../inhalt/pfad.js';

const t = (await getEntry('texte', 'ablauf')).data;
---

<section class="ablauf" aria-labelledby="ablauf-titel">
  <div class="innen">
    <h2 id="ablauf-titel">{t.titel}</h2>
    <ol class="schritte">
      {t.punkte.map((punkt) => <li><b>{punkt.titel}</b><span>{punkt.text}</span></li>)}
    </ol>
    <a class="weiter ablauf__weiter" href={pfad('/info/')}>Abholung, Lieferung und Bezahlung</a>
  </div>
</section>
