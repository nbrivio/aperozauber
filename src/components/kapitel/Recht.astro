---
// Auf der Startseite stehen nur die Verweise. Der Wortlaut steht einmal, auf der Seite Impressum.
import { getCollection, getEntry } from 'astro:content';
import { pfad } from '../../inhalt/pfad.js';

const t = (await getEntry('texte', 'rechtliches')).data;
const abschnitte = (await getCollection('recht')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
---

<section class="recht" id="rechtliches" aria-labelledby="recht-titel">
  <div class="innen">
    <h2 id="recht-titel">{t.titel}</h2>
    <ul class="verweise recht__liste">
      <li><a href={pfad('/info/')}>Abholung, Lieferung und Bezahlung</a></li>
      {abschnitte.map(({ id, data: a }) => <li><a href={pfad(`/impressum/#${id}`)}>{a.titel}</a></li>)}
    </ul>
  </div>
</section>
