---
// Ablauf in Schritten, jeder mit einer kleinen Zeichnung von Hand.
// Die Zeichnungen sind Schmuck: Titel und Text sagen alles, deshalb aria-hidden.
const { punkte } = Astro.props;

const zeichnungen = [
  // Kalenderblatt mit eingekreistem Tag
  `<path d="M14 23c-1-2 1-4 3-4l46-1c2 0 4 2 4 4l1 40c0 3-2 5-5 5l-45 1c-3 0-5-2-5-5z"/><path d="M14 32c16-1 36 0 53-1"/><path d="M27 13c-1 4 0 8 0 11M53 12c1 4 0 9 0 12"/><path d="M23 42h4M38 42h4M53 42h4M23 55h4M53 55h4"/><path class="farbe" d="M32 55c0-7 15-8 16-1 0 8-15 8-16-1 0-2 2-4 4-5"/><path class="farbe" d="M38 55h4"/>`,
  // Zettel mit Haken und Stift
  `<path d="M16 15c12-1 26 0 36-1l2 52c-12 2-26 1-37 2z"/><path d="M24 27c8-1 16 0 22-1M24 37c7-1 14 0 20-1"/><path class="farbe" d="M24 51c3 2 5 5 7 8 4-8 9-13 15-17"/><path d="M61 24l6-2 6 32-3 7-4-6z"/><path d="M62 30l6-2"/>`,
  // Brett mit Käse, Trauben und Zweig
  `<path d="M6 57c0-12 68-13 68-1 0 13-68 14-68 1z"/><path d="M16 55l26-25 6 23z"/><path d="M28 48a1.5 1.5 0 1 0 .1 0M38 42a1.5 1.5 0 1 0 .1 0M37 50a1 1 0 1 0 .1 0"/><path class="farbe" d="M56 42a4 4 0 1 0 .1 0M65 47a4 4 0 1 0 .1 0M58 52a4 4 0 1 0 .1 0"/><path class="farbe" d="M57 41c0-5 3-9 7-10"/><path d="M22 31c-3-6-2-13 2-20"/><path d="M21 26l-6-3M22 20l-5-5M23 25l6-3M24 18l5-4"/>`,
  // Zwei Gläser stossen an
  `<path d="M17 27c1 13 9 19 16 16 6-3 7-13 2-24z"/><path d="M29 44l-4 19M17 64c5-2 11-1 15 1"/><path d="M63 27c-1 13-9 19-16 16-6-3-7-13-2-24z"/><path d="M51 44l4 19M48 65c4-2 10-3 15-1"/><path d="M19 33c5 1 11-1 16-4M61 33c-5 1-11-1-16-4"/><path class="farbe" d="M40 6v7M31 9l3 5M49 9l-3 5"/>`,
];
---

<ol class="schritte schritte--bild">
  {
    punkte.map((punkt, i) => (
      <li>
        {zeichnungen[i] && <svg class="schritte__bild" viewBox="0 0 80 80" aria-hidden="true" focusable="false" set:html={zeichnungen[i]} />}
        <b>{punkt.titel}</b>
        <span>{punkt.text}</span>
      </li>
    ))
  }
</ol>
