---
import Seite from '../layouts/Seite.astro';
import { pfad } from '../inhalt/pfad.js';
---

<Seite intern titel="Seite nicht gefunden" beschreibung="Diese Adresse gibt es nicht.">
  <section class="unterseite" aria-labelledby="leer-titel">
    <div class="innen">
      <div class="worte">
        <h1 id="leer-titel">Hier ist der Tisch noch <span class="hand">leer</span></h1>
        <p>Diese Seite gibt es nicht, oder sie ist umgezogen.</p>
        <div class="wege">
          <a class="knopf" href={pfad('/')}>Zur Startseite</a>
          <a class="weiter" href={pfad('/angebot/')}>Kreationen ansehen</a>
        </div>
      </div>
      <!-- Zeichnung von Hand: ein leeres Brett, eine Traube ist übrig. Schmuck, deshalb aria-hidden. -->
      <svg class="brett" viewBox="10 30 245 120" aria-hidden="true" focusable="false">
        <path d="M22 100c2-28 62-38 108-37 48 1 88 13 88 35 0 25-46 38-98 38-54 0-100-13-98-36z"></path>
        <path d="M44 99c4-17 46-24 86-23 38 1 69 9 69 22"></path>
        <path d="M66 92c9-5 20-6 31-3"></path>
        <path d="M75 88l-3-7M84 86l-1-8M80 90l2 7M90 88l4 5"></path>
        <path class="punkt" d="M104 106h.5M118 96h.5M131 110h.5M142 98h.5M96 100h.5M124 118h.5M150 112h.5"></path>
        <path class="farbe" d="M168 100a7 7 0 1 0 .1 0"></path>
        <path class="farbe" d="M169 99c1-6 5-10 10-11"></path>
        <path d="M236 44c2 30 1 62-2 96"></path>
        <path d="M228 44c-1 9-1 17 0 24 1 7 15 7 16 0 1-7 1-15 0-24M236 44v26"></path>
      </svg>
    </div>
  </section>
</Seite>

<style>
  .unterseite {
    padding: calc(var(--kopf-h) + var(--band-h) + 80px) 20px 110px;
    min-height: 70svh;
  }
  .innen {
    display: grid;
    gap: clamp(30px, 5vw, 70px);
    align-items: center;
  }
  .worte {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  h1 {
    font-size: clamp(40px, 8vw, 96px);
  }
  h1 .hand {
    color: var(--az-fig);
    font-size: 1.25em;
  }
  .wege {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 26px;
  }
  .brett {
    width: min(100%, 420px);
    fill: none;
    stroke: var(--az-ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform: rotate(-3deg);
  }
  .brett .farbe {
    stroke: var(--az-fig);
  }
  .brett .punkt {
    stroke-width: 2.6;
  }
  @media (min-width: 900px) {
    .innen {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    }
    .brett {
      justify-self: end;
    }
  }
</style>
