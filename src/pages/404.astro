---
import Seite from '../layouts/Seite.astro';
import { pfad } from '../inhalt/pfad.js';
---

<Seite intern titel="Seite nicht gefunden" beschreibung="Diese Adresse gibt es nicht.">
  <section class="unterseite" aria-labelledby="leer-titel">
    <div class="innen">
      <h1 id="leer-titel">Hier ist der Tisch noch <span class="hand">leer.</span></h1>
      <p>Diese Seite gibt es nicht, oder sie ist umgezogen.</p>
      <a class="knopf" href={pfad('/')}>Zur Startseite</a>
    </div>
  </section>
</Seite>

<style>
  .unterseite {
    padding: calc(var(--kopf-h) + var(--band-h) + 80px) 20px 110px;
    min-height: 70svh;
  }
  .innen {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  h1 {
    font-size: clamp(40px, 9vw, 104px);
  }
  h1 .hand {
    color: var(--az-fig);
    font-size: 1.25em;
  }
</style>
