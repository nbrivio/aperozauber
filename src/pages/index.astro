---
import { getCollection } from 'astro:content';
import Seite from '../layouts/Seite.astro';
import Auftakt from '../components/kapitel/Auftakt.astro';
import Versprechen from '../components/kapitel/Versprechen.astro';
import Stapel from '../components/kapitel/Stapel.astro';
import Angebot from '../components/kapitel/Angebot.astro';
import Ablauf from '../components/kapitel/Ablauf.astro';
import Sibylle from '../components/kapitel/Sibylle.astro';
import Stimmen from '../components/kapitel/Stimmen.astro';
import FuerWen from '../components/kapitel/FuerWen.astro';
import Recht from '../components/kapitel/Recht.astro';
import { betrieb } from '../inhalt/betrieb.js';
import { verlangeFreigabe } from '../inhalt/stufe.js';

verlangeFreigabe(await getCollection('texte'), 'freigegeben', 'Texte');
verlangeFreigabe(await getCollection('recht'), 'freigegeben', 'Rechtstexte');
verlangeFreigabe(await getCollection('seiten'), 'freigegeben', 'Unterseiten');
verlangeFreigabe(await getCollection('kreationen'), 'bestaetigt', 'Kreationen');
---

<Seite
  start
  titel={`Apéroplatten und Apéro-Kreationen in ${betrieb.ort} | ${betrieb.name}`}
  beschreibung={`Von Hand gestaltete Apéro-Kreationen aus ${betrieb.ort}, für private Anlässe und Firmen. Frag deinen Apéro direkt bei Sibylle an.`}
>
  <Auftakt />
  <Versprechen />
  <Stapel />
  <Angebot />
  <Ablauf />
  <Sibylle />
  <Stimmen />
  <FuerWen />
  <Recht />
</Seite>

<script>
  import '../skripte/bewegung.js';
</script>
