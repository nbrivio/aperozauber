---
// Themenseite für einen Anlass. Sie steht für sich: Text, Kreationen mit Preisen, Mengen,
// Abholung und Bezahlung, Fragen, Ablauf und Anfrage stehen alle auf dieser einen Seite.
// Keine andere Seite verweist hierher, und die Themenseiten verweisen nicht aufeinander.
import { getCollection, getEntry, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Seite from '../../layouts/Seite.astro';
import Titelblatt from '../../components/Titelblatt.astro';
import { pfad } from '../../inhalt/pfad.js';
import Preise from '../../components/Preise.astro';

export async function getStaticPaths() {
  const alle = await getCollection('anlaesse');
  return alle.map((anlass) => ({ params: { id: anlass.id }, props: { anlass } }));
}

const { anlass } = Astro.props;
const a = anlass.data;
const { Content } = await render(anlass);
const alleKreationen = await getCollection('kreationen');
const kreationen = a.kreationen.map((id) => {
  const treffer = alleKreationen.find((k) => k.id === id);
  if (!treffer) throw new Error(`Anlass ${anlass.id} nennt eine unbekannte Kreation: ${id}`);
  return treffer;
});
const karten = await Promise.all(kreationen.map(async (k) => ({ id: k.id, k: k.data, Content: (await render(k)).Content })));
const platten = kreationen.filter((k) => k.data.art === 'kreation');
const groessen = (platten[0] ?? alleKreationen.find((k) => k.data.art === 'kreation')).data.groessen;
const ablauf = (await getEntry('texte', 'ablauf')).data;
const info = (await getEntry('seiten', 'info')).data;
// Abholung, Lieferung, Bezahlung und Kühlung stehen im Wortlaut der Info-Seite auch hier.
const praktisch = ['Abholung', 'Lieferst', 'bezahlen', 'kühlen'].map((wort) => {
  const treffer = info.fragen.find((f) => f.frage.includes(wort));
  if (!treffer) throw new Error(`Info-Seite: Frage mit «${wort}» fehlt.`);
  return treffer;
});
const krumen = [[a.kurz, `/apero/${anlass.id}/`]];
const adresse = new URL(pfad(`/apero/${anlass.id}/`), Astro.site).href;
const anfang = new URL(pfad('/'), Astro.site).href;
const preise = kreationen.flatMap((k) => (k.data.art === 'kreation' ? k.data.groessen.map((g) => g.preis) : [k.data.stueckpreis]));
const angebot = {
  '@type': 'Service',
  '@id': `${adresse}#angebot`,
  name: a.seitentitel,
  description: a.beschreibung,
  serviceType: 'Apéroplatten',
  image: new URL(a.bild.src, Astro.site).href,
  provider: { '@id': `${anfang}#betrieb` },
  audience: { '@type': 'Audience', audienceType: a.art === 'firma' ? 'Firmen' : 'Privatpersonen' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'CHF',
    lowPrice: Math.min(...preise),
    highPrice: Math.max(...preise),
    offerCount: preise.length,
    seller: { '@id': `${anfang}#betrieb` },
  },
};
const fragen = {
  '@type': 'FAQPage',
  '@id': `${adresse}#fragen`,
  mainEntity: [...a.fragen, ...praktisch].map((f) => ({ '@type': 'Question', name: f.frage, acceptedAnswer: { '@type': 'Answer', text: f.antwort } })),
};
---

<Seite titel={a.seitentitel} beschreibung={a.beschreibung} pfad={krumen} daten={[angebot, fragen]} anlass={a.kurz}>
  <Titelblatt krumen={krumen} etikett={a.etikett} titel={a.titel} bild>
    <p class="gross">{a.lead}</p>
    <a class="knopf" href="#anfrage" data-fuer={a.art === 'firma' ? 'Firma' : 'Privat'}>{a.knopf}</a>
    <div class="bild" slot="bild">
      <Picture src={a.bild} alt={a.bildAlt} formats={['avif', 'webp']} widths={[520, 760]} sizes="(max-width: 560px) 90vw, 520px" loading="eager" fetchpriority="high" />
    </div>
  </Titelblatt>

  <section class="abschnitt" aria-labelledby="anlass-text">
    <div class="innen">
      <h2 id="anlass-text">{a.art === 'firma' ? 'Ein Apéro, um den du dich nicht kümmern musst' : 'So wird es euer Apéro'}</h2>
      <div class="abschnitt__inhalt prosa"><Content /></div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="anlass-abnehmen">
    <div class="innen">
      <h2 id="anlass-abnehmen">Das nehme ich dir ab</h2>
      <dl class="punkte abschnitt__inhalt">
        {a.abnehmen.map((p) => <div><dt>{p.titel}</dt><dd>{p.text}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="abschnitt abschnitt--breit" aria-labelledby="anlass-kreationen">
    <div class="innen">
      <h2 id="anlass-kreationen">Das passt dazu</h2>
    </div>
    <div class="gitter">
      {
        karten.map(({ id, k, Content: Text }) => (
          <article class="karte">
            <div class:list={['bild', k.bild ? null : `ton-${k.ton}`]}>
              {k.bild ? <Picture src={k.bild} alt={k.bildAlt} formats={['avif', 'webp']} widths={[330, 660]} sizes="(max-width: 640px) 90vw, 330px" loading="lazy" /> : <span class="hand">Bild folgt</span>}
            </div>
            <div class="inhalt">
              <h3><a href={pfad(`/angebot/${id}/`)}>{k.name}</a></h3>
              {k.notiz && <p class="notiz">{k.notiz}</p>}
              <Text />
              <Preise kreation={k} />
              <div class="fuss">
                <a href="#anfrage" data-kreation={id} aria-label={`${k.name} anfragen`}>Anfragen</a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="anlass-ruf">
    <div class="innen">
      <h2 id="anlass-ruf">{a.ruf.titel}</h2>
      <div class="abschnitt__inhalt prosa">
        <p class="gross">{a.ruf.text}</p>
        <p><a class="knopf" href="#anfrage" data-fuer={a.art === 'firma' ? 'Firma' : 'Privat'}>{a.knopf}</a></p>
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="anlass-menge">
    <div class="innen">
      <h2 id="anlass-menge">Wie viel braucht es?</h2>
      <div class="abschnitt__inhalt prosa">
        <table class="groessen">
          <caption class="verborgen">Grössen der Kreationen</caption>
          <thead class="verborgen"><tr><th scope="col">Grösse</th><th scope="col">Personen</th></tr></thead>
          <tbody>
            {groessen.map((g) => <tr><th scope="row">{g.groesse}</th><td>für {g.personen} Personen</td></tr>)}
          </tbody>
        </table>
        <p>Für eine grössere Runde kombiniere ich mehrere Platten. Die Preise je Grösse stehen oben bei jeder Kreation. Es sind Richtpreise, verbindlich werden sie mit meiner Bestätigung.</p>
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="anlass-fragen">
    <div class="innen">
      <h2 id="anlass-fragen">Fragen dazu</h2>
      <div class="abschnitt__inhalt">
        <dl class="fragen">
          {a.fragen.map((f) => <div><dt>{f.frage}</dt><dd>{f.antwort}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="anlass-praktisch">
    <div class="innen">
      <h2 id="anlass-praktisch">Abholung, Lieferung und Bezahlung</h2>
      <div class="abschnitt__inhalt">
        <dl class="fragen">
          {praktisch.map((f) => <div><dt>{f.frage}</dt><dd>{f.antwort}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="anlass-ablauf">
    <div class="innen">
      <h2 id="anlass-ablauf">{ablauf.titel}</h2>
      <ol class="schritte abschnitt__inhalt">
        {ablauf.punkte.map((punkt) => <li><b>{punkt.titel}</b><span>{punkt.text}</span></li>)}
      </ol>
    </div>
  </section>
</Seite>

<style>
  .abschnitt--breit {
    padding-bottom: 0;
  }
  .abschnitt--breit .innen {
    margin-bottom: 28px;
  }
  .gitter {
    padding-inline: 0;
  }
  .abschnitt--breit .gitter {
    padding-bottom: clamp(70px, 9vw, 130px);
  }
  .karte h3 {
    font-size: 32px;
  }
  .schritte li {
    grid-template-columns: 54px 1fr;
  }
</style>
