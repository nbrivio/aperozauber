---
// Themenseite für einen Anlass: eigener Text, passende Kreationen, Mengen und Fragen.
import { getCollection, getEntry, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Seite from '../../layouts/Seite.astro';
import Titelblatt from '../../components/Titelblatt.astro';
import { pfad } from '../../inhalt/pfad.js';
import { preiszeile } from '../../inhalt/preis.js';

export async function getStaticPaths() {
  const alle = (await getCollection('anlaesse')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
  return alle.map((anlass) => ({ params: { id: anlass.id }, props: { anlass, andere: alle.filter((a) => a.id !== anlass.id) } }));
}

const { anlass, andere } = Astro.props;
const a = anlass.data;
const { Content } = await render(anlass);
const alleKreationen = await getCollection('kreationen');
const kreationen = a.kreationen.map((id) => {
  const treffer = alleKreationen.find((k) => k.id === id);
  if (!treffer) throw new Error(`Anlass ${anlass.id} nennt eine unbekannte Kreation: ${id}`);
  return treffer;
});
const karten = await Promise.all(kreationen.map(async (k) => ({ id: k.id, k: k.data, Content: (await render(k)).Content })));
const groessen = alleKreationen.find((k) => k.data.art === 'kreation').data.groessen;
const ablauf = (await getEntry('texte', 'ablauf')).data;
const krumen = [['Anlässe', '/apero/'], [a.etikett.replace(/^Für (den |die |deinen |das )?/, ''), `/apero/${anlass.id}/`]];
const fragen = {
  '@type': 'FAQPage',
  '@id': `${new URL(pfad(`/apero/${anlass.id}/`), Astro.site).href}#fragen`,
  mainEntity: a.fragen.map((f) => ({ '@type': 'Question', name: f.frage, acceptedAnswer: { '@type': 'Answer', text: f.antwort } })),
};
---

<Seite titel={a.seitentitel} beschreibung={a.beschreibung} pfad={krumen} daten={[fragen]}>
  <Titelblatt krumen={krumen} etikett={a.etikett} titel={a.titel}>
    <p class="gross">{a.lead}</p>
    <a class="knopf" href="#anfrage" data-fuer={a.art === 'firma' ? 'Firma' : 'Privat'}>Apéro anfragen</a>
  </Titelblatt>

  <section class="abschnitt" aria-labelledby="anlass-text">
    <div class="innen">
      <h2 id="anlass-text">So wird es euer Apéro</h2>
      <div class="abschnitt__inhalt prosa"><Content /></div>
    </div>
  </section>

  <section class="abschnitt abschnitt--breit" aria-labelledby="anlass-kreationen">
    <div class="innen">
      <h2 id="anlass-kreationen">Das passt dazu</h2>
    </div>
    <div class="gitter">
      {
        karten.map(({ id, k, Content: Text }) => (
          <article class="karte">
            <div class:list={['bild', k.bild ? null : `ton-${k.ton}`]}>
              {k.bild ? <Picture src={k.bild} alt={k.bildAlt} formats={['avif', 'webp']} widths={[330, 660]} sizes="(max-width: 640px) 90vw, 330px" loading="lazy" /> : <span class="hand">Bild folgt</span>}
            </div>
            <div class="inhalt">
              <h3><a href={pfad(`/angebot/${id}/`)}>{k.name}</a></h3>
              {k.notiz && <p class="notiz">{k.notiz}</p>}
              <Text />
              <div class="fuss">
                <span class="preis">{preiszeile(k)}</span>
                <a href="#anfrage" data-kreation={id} aria-label={`${k.name} anfragen`}>Anfragen</a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="anlass-menge">
    <div class="innen">
      <h2 id="anlass-menge">Wie viel braucht es?</h2>
      <div class="abschnitt__inhalt prosa">
        <table class="groessen">
          <caption class="verborgen">Grössen der Kreationen</caption>
          <thead class="verborgen"><tr><th scope="col">Grösse</th><th scope="col">Personen</th></tr></thead>
          <tbody>
            {groessen.map((g) => <tr><th scope="row">{g.groesse}</th><td>für {g.personen} Personen</td></tr>)}
          </tbody>
        </table>
        <p>Für eine grössere Runde kombiniere ich mehrere Platten. <a href={pfad('/angebot/')}>Alle Kreationen mit Preisen</a></p>
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="anlass-fragen">
    <div class="innen">
      <h2 id="anlass-fragen">Fragen dazu</h2>
      <div class="abschnitt__inhalt">
        <dl class="fragen">
          {a.fragen.map((f) => <div><dt>{f.frage}</dt><dd>{f.antwort}</dd></div>)}
        </dl>
        <a class="weiter" href={pfad('/info/')}>Abholung, Lieferung und Bezahlung</a>
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="anlass-ablauf">
    <div class="innen">
      <h2 id="anlass-ablauf">{ablauf.titel}</h2>
      <ol class="schritte abschnitt__inhalt">
        {ablauf.punkte.map((punkt) => <li><b>{punkt.titel}</b><span>{punkt.text}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="anlass-andere">
    <div class="innen">
      <h2 id="anlass-andere">Andere Anlässe</h2>
      <ul class="verweise abschnitt__inhalt">
        {andere.map((x) => <li><a href={pfad(`/apero/${x.id}/`)}>{x.data.seitentitel}</a></li>)}
        {a.art === 'firma' && <li><a href={pfad('/firmenapero/')}>Firmenapéro im Überblick</a></li>}
      </ul>
    </div>
  </section>
</Seite>

<style>
  .abschnitt--breit {
    padding-bottom: 0;
  }
  .abschnitt--breit .innen {
    margin-bottom: 28px;
  }
  .gitter {
    padding-inline: 0;
  }
  .abschnitt--breit .gitter {
    padding-bottom: clamp(70px, 9vw, 130px);
  }
  .karte h3 {
    font-size: 32px;
  }
  .schritte li {
    grid-template-columns: 54px 1fr;
  }
</style>
